/* Settings, orange note under the "Open at login" switch when it is on but the app is not in an Applications folder. */
"settings.launchAtLogin.outsideApplications" = "This copy isn't in an Applications folder, so it stops opening at login once it is moved or rebuilt. Move it to Applications, then turn this on again.";

/* Settings, heading of the section that lists apps that are never suggested for relaunch. */
"settings.section.exclusions" = "Excluded apps";

/* Settings, grey text shown in the excluded apps section while the list is empty. */
"settings.exclusions.empty" = "No excluded apps.";

/* Settings, button at the right of an excluded app: takes the app off the list (it can be suggested again). */
"settings.exclusions.remove" = "Remove";

/* Settings, title of the menu button that lists the apps currently running so one can be added to the excluded apps. */
"settings.exclusions.addMenu" = "Add from running apps";

/* Settings window, last row: label next to the app's version number (e.g. "0.1"). One short word. */
"settings.version" = "Version";


/* ==== Menu bar ==== */

/* Accessibility label (read aloud by VoiceOver, not shown) of the app's icon in the menu bar. */
"menuBar.accessibilityLabel" = "Memory monitor";


/* ==== Notification ==== */

/* Title of the system notification posted when memory pressure is high and an app or WindowServer is worth acting on. */
