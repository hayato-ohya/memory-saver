/* ==== Errors ==== */

/* Popover, orange line above the footer, shown instead of any data when the history database could not be opened. %@ = the system's description of the error (in the user's system language). The line is about 330 pt wide and may wrap. */
"error.historyOpenFailed" = "Could not open the history database: %@";

/* Popover, orange line above the footer: the history database could not be used, so measurements are kept in memory only until the app quits. %@ = the system's description of the error. "MemorySaver" is the product name. */
"error.historyUnsaved" = "History cannot be saved, so it is kept only until MemorySaver quits: %@";

/* Popover, orange line above the footer: the memory measurement itself failed. %@ = the system's description of the error. */
"error.memoryReadFailed" = "Could not read memory information: %@";

/* Popover, orange line above the footer: current numbers are shown, but saving or reading the history failed. %@ = the system's description of the error. */
"error.historyAccessFailed" = "Could not save or read history: %@";
