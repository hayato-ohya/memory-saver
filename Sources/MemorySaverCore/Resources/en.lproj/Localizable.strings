/* ==== Settings ==== */

/* Title bar of the settings window. "MemorySaver" is the product name and stays as is. */
"settings.windowTitle" = "MemorySaver Settings";

/* Settings, heading of the section with the three steppers that decide when an app or WindowServer is flagged. */
"settings.section.thresholds" = "Thresholds";

/* Settings, label of a stepper: an app is suggested for relaunch once it uses at least this much memory. %@ = the amount, already formatted with its unit (e.g. "2 GB"). The window is 440 pt wide; the stepper takes space at the right. */
"settings.threshold.appFootprint" = "App memory: %@ or more";

/* Settings, label of a stepper: an app is suggested for relaunch once its memory has grown to at least this multiple of its size just after launch. %@ = the factor with one decimal place, formatted for the user's locale (e.g. "1.5"). */
"settings.threshold.appGrowth" = "Growth since launch: %@ times or more";

/* Settings, label of a stepper: WindowServer is flagged once its memory has grown by at least this much. %@ = the amount, already formatted with its unit (e.g. "1 GB"). "WindowServer" is the macOS process name and stays as is. */
"settings.threshold.windowServerGrowth" = "WindowServer growth: %@ or more";

/* Settings, heading of the section with the notification and login options. */
"settings.section.notifications" = "Notifications";

/* Settings, label of the switch that turns system notifications on or off. */
"settings.notifications.toggle" = "Notify when memory is running low";

/* Settings, orange note under the notifications switch, shown when the user switched notifications on here but macOS refuses them. Use the exact names macOS uses for "System Settings" and its "Notifications" pane. "MemorySaver" is the product name. */
