<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      MemorySaver translations: plurals. See Localizable.strings for how to add a language.
      Each entry has one <key> per plural category. Provide the categories your language needs
      (zero, one, two, few, many, other); "other" is always required. Keep %lld in each form
      and keep the keys and the NSString... keys unchanged. Japanese, for example, has only "other".
    -->
    <!-- Popover, WindowServer section: number of windows an app has, right-aligned on the same row as the app name. %lld = the number of windows (a whole number, 1 or more). Plural entry: see Localizable.stringsdict. Keep it short. -->
    <key>popover.windowServer.windowCount</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld window</string>
            <key>other</key>
            <string>%lld windows</string>
        </dict>
    </dict>
    <!-- Popover, ranking row: small grey line under the app name, giving the number of processes the app consists of. %lld = the number of processes (1 or more). Plural entry: see Localizable.stringsdict. The row is tight: keep it as short as possible. -->
    <key>popover.ranking.processCount</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld process</string>
            <key>other</key>
            <string>%lld processes</string>
        </dict>
    </dict>
</dict>
</plist>
