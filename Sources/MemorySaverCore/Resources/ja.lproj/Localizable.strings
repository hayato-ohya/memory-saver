"legend.menuBar.normal" = "正常。再起動の提案はありません";

/* Icon legend: explains the menu bar icon drawn filled with a small orange dot. The parenthesis describes how the icon looks; keep it accurate. */
"legend.menuBar.recommendation" = "再起動すると効果が大きいアプリがあります（塗りつぶし＋オレンジの点）";

/* Icon legend: explains the yellow menu bar icon. "Warning" must match the wording of popover.pressure.warning. The colour is part of the explanation. */
"legend.menuBar.warning" = "メモリプレッシャーが「警告」です（黄）";

/* Icon legend: explains the red menu bar icon. "Critical" must match the wording of popover.pressure.critical. The colour is part of the explanation. */
"legend.menuBar.critical" = "メモリプレッシャーが「危険」です（赤）";

/* Icon legend: small grey heading above the explanations of the icons inside the popover ("this window" is the popover). */
"legend.section.window" = "この画面のアイコン";

/* Icon legend: explains the small right-pointing arrow at the left of each app row in the ranking. */
"legend.window.expand" = "アプリのプロセス内訳を開く／閉じる（行のどこをクリックしても開閉します）";

/* Icon legend: explains the circular-arrow button in the popover footer. */
"legend.window.refresh" = "今すぐ測定し直す";

/* Icon legend: explains the gear button in the popover footer. */
"legend.window.settings" = "設定を開く";

/* Icon legend: explains the power button in the popover footer. "MemorySaver" is the product name and stays as is. */
"legend.window.quit" = "MemorySaver を終了";

/* Icon legend: small grey heading above the explanation of the figures starting with a plus sign. */
"legend.section.growth" = "増加量（＋の数字）";

/* Icon legend: explains the growth figures shown under an app's memory amount. "+604 MB" is an example of such a figure. "WindowServer" is the macOS process name and stays as is. Wraps onto several lines. */
"legend.growth.note" = "メモリ量の下の「+604 MB」などは、起動直後（WindowServer は Mac の起動時）からの増加量です。";

/* Help popup, last line in small grey text. Argument: the version number, e.g. "0.1". "MemorySaver" is the product name and stays as is. */
"legend.version" = "MemorySaver バージョン %@";


/* ==== Settings ==== */

/* Title bar of the settings window. "MemorySaver" is the product name and stays as is. */
"settings.windowTitle" = "MemorySaver の設定";

/* Settings, heading of the section with the three steppers that decide when an app or WindowServer is flagged. */
"settings.section.thresholds" = "しきい値";

/* Settings, label of a stepper: an app is suggested for relaunch once it uses at least this much memory. %@ = the amount, already formatted with its unit (e.g. "2 GB"). The window is 440 pt wide; the stepper takes space at the right. */
"settings.threshold.appFootprint" = "アプリのメモリ: %@ 以上";

/* Settings, label of a stepper: an app is suggested for relaunch once its memory has grown to at least this multiple of its size just after launch. %@ = the factor with one decimal place, formatted for the user's locale (e.g. "1.5"). */
"settings.threshold.appGrowth" = "起動直後からの増加: %@ 倍以上";

/* Settings, label of a stepper: WindowServer is flagged once its memory has grown by at least this much. %@ = the amount, already formatted with its unit (e.g. "1 GB"). "WindowServer" is the macOS process name and stays as is. */
"settings.threshold.windowServerGrowth" = "WindowServer の増加: %@ 以上";

/* Settings, heading of the section with the notification and login options. */
"settings.section.notifications" = "通知";

/* Settings, label of the switch that turns system notifications on or off. */
"settings.notifications.toggle" = "メモリが逼迫したときに通知する";

/* Settings, orange note under the notifications switch, shown when the user switched notifications on here but macOS refuses them. Use the exact names macOS uses for "System Settings" and its "Notifications" pane. "MemorySaver" is the product name. */
"settings.notifications.denied" = "システム設定で MemorySaver の通知が許可されていないため、通知は表示されません。システム設定の「通知」から許可してください。";

/* Settings, label of the switch that makes the app start when the user logs in. */
"settings.launchAtLogin.toggle" = "ログイン時に起動する";

/* Settings, orange note under the "Open at login" switch when changing it failed. %@ = the system's description of the error (in the user's system language). The name of the option must match settings.launchAtLogin.toggle. */
"settings.launchAtLogin.error" = "ログイン時の起動を変更できませんでした: %@";

/* Settings, heading of the section that lists apps that are never suggested for relaunch. */
"settings.section.exclusions" = "除外するアプリ";

/* Settings, grey text shown in the excluded apps section while the list is empty. */
"settings.exclusions.empty" = "除外しているアプリはありません。";

/* Settings, button at the right of an excluded app: takes the app off the list (it can be suggested again). */
"settings.exclusions.remove" = "削除";

/* Settings, title of the menu button that lists the apps currently running so one can be added to the excluded apps. */
"settings.exclusions.addMenu" = "実行中のアプリから追加";

/* Settings window, last row: label next to the app's version number (e.g. "0.1"). One short word. */
"settings.version" = "バージョン";


/* ==== Menu bar ==== */

/* Accessibility label (read aloud by VoiceOver, not shown) of the app's icon in the menu bar. */
"menuBar.accessibilityLabel" = "メモリ監視";


/* ==== Notification ==== */

/* Title of the system notification posted when memory pressure is high and an app or WindowServer is worth acting on. */
"notification.title" = "メモリが逼迫しています";

/* Body of the system notification, first sentence. %@ = the names of the apps worth relaunching, joined with the list separator (notification.appListSeparator). A complete sentence. */
"notification.relaunchApps" = "%@ を再起動すると改善する可能性があります。";

/* Body of the system notification, sentence about WindowServer (the macOS process name; it stays as is). It is added after the sentence about apps when both apply. */
"notification.windowServer" = "WindowServer のメモリが増えています。";

/* Separator placed between app names in a list inside the notification ("Foo, Bar, Baz"). Include any space you need. */
"notification.appListSeparator" = "、";

/* Separator placed between the sentences of the notification body when it has more than one. Include any space you need (may be empty in languages that do not separate sentences with a space; a single space is the value here). */
"notification.sentenceSeparator" = " ";


/* ==== Errors ==== */

/* Popover, orange line above the footer, shown instead of any data when the history database could not be opened. %@ = the system's description of the error (in the user's system language). The line is about 330 pt wide and may wrap. */
"error.historyOpenFailed" = "履歴データベースを開けませんでした: %@";

/* Popover, orange line above the footer: the history database could not be used, so measurements are kept in memory only until the app quits. %@ = the system's description of the error. "MemorySaver" is the product name. */
"error.historyUnsaved" = "履歴を保存できません（今回の起動中のみ記録します）: %@";

/* Popover, orange line above the footer: the memory measurement itself failed. %@ = the system's description of the error. */
"error.memoryReadFailed" = "メモリ情報を取得できませんでした: %@";

/* Popover, orange line above the footer: current numbers are shown, but saving or reading the history failed. %@ = the system's description of the error. */
"error.historyAccessFailed" = "履歴を保存・参照できませんでした: %@";
