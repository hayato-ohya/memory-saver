/* ==== Popover: header ==== */

/* Popover, empty state shown until the first memory sample arrives. Title, one short line, shown above the description. */
"popover.measuring.title" = "計測中";

/* Popover, empty state: explanation under the title "Measuring". One line, about 330 pt wide at most. */
"popover.measuring.description" = "最初のサンプルを取得しています。";

/* Popover, shown instead of the memory figures when no sample could be taken. Title, one short line; the error message appears under it. */
"popover.unavailable.title" = "メモリ情報を表示できません";

/* Popover, headline at the top left of the memory summary. Shares the row with the memory pressure label, so keep it to one short word. */
"popover.header.memory" = "メモリ";

/* Popover, memory summary, right-aligned under the usage bar; only shown when swap is in use. %@ = amount of swap in use, already formatted with its unit (e.g. "2 GB"). Shares the row with the "used / total" figures; keep it short. */
"popover.header.swap" = "スワップ %@";

/* Popover, memory summary, right of the headline "Memory", shown in green. The state of the macOS memory pressure indicator (the same one Activity Monitor shows). Must fit on one line next to the headline. */
"popover.pressure.normal" = "プレッシャー: 通常";

/* Popover, memory summary, shown in yellow. Memory pressure is at the macOS "warning" level. Same row and length limit as the "Normal" label; keep the three pressure labels parallel. */
"popover.pressure.warning" = "プレッシャー: 警告";

/* Popover, memory summary, shown in red. Memory pressure is at the macOS "critical" level. Same row and length limit as the "Normal" label. */
"popover.pressure.critical" = "プレッシャー: 危険";


/* ==== Popover: WindowServer ==== */

/* Popover, WindowServer section, right of the name "WindowServer" (a macOS system process name; do not translate it elsewhere). Shown when its memory use could not be read. One word or short phrase. */
"popover.windowServer.unavailable" = "取得不可";

/* Popover, WindowServer section, small grey heading above a list of app names with their window counts and estimated window memory, largest first. The list is an estimate. One line. */
"popover.windowServer.suspectsTitle" = "ウィンドウの大きいアプリ（推定）";

/* Popover, WindowServer section, small grey note under the list of apps. May wrap onto several lines (the popover is 360 pt wide). "WindowServer" is the macOS process name and stays as is. */
"popover.windowServer.suspectsNote" = "正確な内訳は取得できないため推定です。これらのアプリを再起動すると WindowServer のメモリが減る場合があります。";


/* ==== Popover: recommendations ==== */

/* Popover, headline of the section that lists apps worth relaunching to get their memory back. One line. */
"popover.recommendations.title" = "再起動をおすすめ";


/* ==== Popover: ranking ==== */

/* Popover, headline of the list of apps ordered by memory use. The list always shows the ten largest apps; the number is part of the text. One line. */
"popover.ranking.title" = "アプリ別メモリ（上位10）";

/* Popover, small grey line under the ranking headline. Explains that clicking an app row shows the processes that belong to the app. One line. */
"popover.ranking.hint" = "行をクリックするとプロセスの内訳を表示します";

/* Tooltip of an app row in the ranking while its process list is open. Clicking the row closes the list. */
"popover.ranking.rowHelp.hide" = "プロセスの内訳を閉じる";

/* Tooltip of an app row in the ranking while its process list is closed. Clicking the row opens the list. */
"popover.ranking.rowHelp.show" = "プロセスの内訳を表示";

/* Accessibility hint (read aloud by VoiceOver, not shown) of an app row in the ranking. Describes what activating the row does. */
"popover.ranking.rowHint" = "プロセスの内訳を開閉します";


/* ==== Popover: footer ==== */

/* Popover, bottom left, small grey text. %@ = the time of the last measurement, already formatted for the user's locale (e.g. "7:13:20"). Must fit next to four icon buttons. */
"popover.footer.updated" = "更新 %@";

/* Tooltip of the circular-arrow button at the bottom right of the popover, which measures memory again immediately. */
"popover.footer.refresh.help" = "今すぐ更新";

/* Accessibility label (read aloud by VoiceOver, not shown) of the circular-arrow button at the bottom right of the popover. */
"popover.footer.refresh.accessibilityLabel" = "更新";

/* Tooltip of the gear button at the bottom right of the popover, which opens the settings window. */
"popover.footer.settings.help" = "設定";

/* Accessibility label (read aloud by VoiceOver, not shown) of the gear button at the bottom right of the popover. */
"popover.footer.settings.accessibilityLabel" = "設定";

/* Tooltip of the power button at the bottom right of the popover, which quits the app. "MemorySaver" is the product name and stays as is. */
"popover.footer.quit.help" = "MemorySaver を終了";

/* Accessibility label (read aloud by VoiceOver, not shown) of the power button at the bottom right of the popover. */
"popover.footer.quit.accessibilityLabel" = "終了";


/* ==== Relaunch ==== */

/* Button that quits an app and opens it again. It appears on every app row in the ranking, in a column only 52 pt wide, and also (larger) in the suggested relaunches list. Keep it to a single short word. */
"relaunch.button" = "再起動";

/* Title of the confirmation dialog shown after the Relaunch button is pressed. %@ = the name of the app. */
"relaunch.confirm.title" = "%@ を再起動しますか？";

/* Message of the relaunch confirmation dialog, under its title. %@ = the name of the app. The app is asked to quit normally, so it may show its own "save changes?" prompt. */
"relaunch.confirm.message" = "%@ を終了してから開き直します。未保存の書類がある場合は、アプリが保存の確認を表示します。";

/* Default button of the relaunch confirmation dialog: confirms the relaunch. Dialog button, so it can be wider than the list button. */
"relaunch.confirm.button" = "再起動";

/* Cancel button of the relaunch confirmation dialog: nothing is quit. */
"relaunch.confirm.cancel" = "キャンセル";

/* Popover, small text under an app row while a relaunch is in progress: the app was asked to quit and has not quit yet. May wrap onto two lines (360 pt wide popover). */
"relaunch.status.waiting" = "終了を待っています…（アプリが保存の確認を表示している場合があります）";

/* Link-style button under the "Waiting for the app to quit…" text. Gives up waiting; the app is not reopened. */
"relaunch.status.stopWaiting" = "待つのをやめる";

/* Tooltip of the "Stop waiting" button. Explains that the app is left alone: it is not force-quit and is not reopened if it quits later. */
"relaunch.status.stopWaitingHelp" = "アプリは強制終了されず、終了しても開き直しません";

/* Link-style button at the right of a relaunch result message. Removes the message. Shares the row with the message; keep it short. */
"relaunch.status.dismiss" = "閉じる";

/* A relaunch status message prefixed with the app's name, used for apps no longer in the lists above. %1$@ = the name of the app. %2$@ = the status message, a complete sentence (one of the relaunch.status / relaunch.result texts). Only the punctuation and order are yours to change. */
"relaunch.status.withAppName" = "%1$@: %2$@";

/* Popover, result of a relaunch attempt: by the time the button was confirmed, the app was no longer running (or its process id now belongs to another program), so nothing was quit. Wraps onto several lines. */
"relaunch.result.notRunning" = "アプリは既に終了しているか別のアプリに置き換わっているため、何もしませんでした。";

/* Popover, result of a relaunch attempt that failed before anything was quit. %@ = the reason, a complete sentence from the relaunch.error texts. Wraps onto several lines. */
"relaunch.result.failed" = "再起動できませんでした（アプリは終了していません）: %@";

/* Popover, result after the user pressed "Stop waiting". The app was never force-quit and will not be reopened. */
"relaunch.result.stoppedWaiting" = "待つのをやめました。アプリはまだ終了していない場合があり、終了しても開き直しません。";

/* Popover, result when the app did not quit within the time limit of 5 minutes (the number is fixed in the app). "MemorySaver" is the product name. Long: wraps onto several lines. */
"relaunch.result.waitTimedOut" = "5分待ちましたが終了しなかったため、待つのをやめました。あとでアプリが終了しても自動では開き直さないので、必要なら手動で開いてください。";

/* Popover, result when the app quit but could not be started again. %@ = the system's description of the error (in the user's system language, not controlled by this file). */
"relaunch.result.quitButNotReopened" = "終了しましたが、開き直せませんでした（%@）。手動で開いてください。";

/* Reason shown inside the "Couldn't relaunch" message (relaunch.result.failed): the app is a system component or has no app bundle to reopen. A complete sentence with a final full stop. */
"relaunch.error.unsupported" = "このアプリは再起動できません。";

/* Reason shown inside the "Couldn't relaunch" message (relaunch.result.failed): the app file was moved or deleted, so nothing was quit. A complete sentence with a final full stop. */
"relaunch.error.appNotFound" = "アプリの場所が見つからないため、終了せずに中止しました。";

/* Reason shown inside the "Couldn't relaunch" message (relaunch.result.failed): the system could not deliver the request to quit to the app. A complete sentence with a final full stop. */
"relaunch.error.quitRefused" = "アプリに終了を要求できませんでした。";


/* ==== Growth ==== */

/* Tooltip on an app's growth figure (the "+620 MB" under its memory amount). %@ = the growth, already formatted with a plus sign and unit (e.g. "+620 MB"). The baseline is the app's size shortly after it launched. */
"growth.sinceLaunch" = "起動直後より %@";

/* Tooltip on WindowServer's growth figure. %@ = the growth, already formatted with a plus sign and unit (e.g. "+620 MB"). The baseline is its size when the Mac started up. */
"growth.sinceStartup" = "起動時より %@";

/* Tooltip on a growth figure for an app that was already running when MemorySaver started measuring. %@ = the growth, already formatted with a plus sign and unit (e.g. "+620 MB"). The baseline is its size when MemorySaver first saw it. */
"growth.sinceMonitoringBegan" = "監視開始時より %@";


