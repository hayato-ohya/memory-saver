<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Popover, WindowServer section: number of windows an app has, right-aligned on the same row as the app name. %lld = the number of windows (a whole number, 1 or more). Plural entry: see Localizable.stringsdict. Keep it short. -->
    <key>popover.windowServer.windowCount</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>other</key>
            <string>%lld ウィンドウ</string>
        </dict>
    </dict>
    <!-- Popover, ranking row: small grey line under the app name, giving the number of processes the app consists of. %lld = the number of processes (1 or more). Plural entry: see Localizable.stringsdict. The row is tight: keep it as short as possible. -->
    <key>popover.ranking.processCount</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>other</key>
            <string>%lld プロセス</string>
        </dict>
    </dict>
</dict>
</plist>
